# ---------------------------------------------------------------------------
# Secrets & environment — NEVER commit real values.
# Only `.env.example` files (placeholders) are tracked. See docs/06.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.p12
secrets/

# Service-account / cloud credentials
gcp-*.json
service-account*.json
credentials.json

