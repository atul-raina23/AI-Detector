# ===========================================================================
# EngineeringOS AI — Example environment file
# ---------------------------------------------------------------------------
# Copy to `.env` and fill in REAL values locally. NEVER commit `.env`.
# Every value here is a PLACEHOLDER — no real secrets in version control.
# See docs/06-security-privacy-consent.md and docs/deployment/ for details.
# ===========================================================================

# --- Runtime -------------------------------------------------------------
NODE_ENV=development
API_PORT=3000
WEB_PORT=4200
PUBLIC_APP_URL=http://localhost:4200
PUBLIC_API_URL=http://localhost:3000

# --- Database (PostgreSQL / Sequelize) -----------------------------------
DATABASE_URL=postgres://eos:CHANGE_ME@localhost:5432/engineeringos
DB_SSL=false

# --- Redis (cache + BullMQ queues) ---------------------------------------
REDIS_URL=redis://localhost:6379

# --- Auth / JWT ----------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_STRING
JWT_ACCESS_TTL=900          # seconds (15m)
JWT_REFRESH_TTL=2592000     # seconds (30d)

# --- OAuth providers (client id/secret from each provider console) -------
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_ME
MICROSOFT_OAUTH_CLIENT_ID=REPLACE_ME
MICROSOFT_OAUTH_CLIENT_SECRET=REPLACE_ME
GITHUB_OAUTH_CLIENT_ID=REPLACE_ME
GITHUB_OAUTH_CLIENT_SECRET=REPLACE_ME

# --- GitHub App (integration) --------------------------------------------
GITHUB_APP_ID=000000
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem   # gitignored
GITHUB_APP_WEBHOOK_SECRET=REPLACE_ME

# --- Integrations --------------------------------------------------------
JIRA_CLIENT_ID=REPLACE_ME
JIRA_CLIENT_SECRET=REPLACE_ME
LINEAR_API_KEY=REPLACE_ME
TEAMS_APP_ID=REPLACE_ME
TEAMS_APP_PASSWORD=REPLACE_ME
SLACK_BOT_TOKEN=xoxb-REPLACE_ME

# --- AI providers (routed — see docs/07) ---------------------------------
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
OPENAI_API_KEY=sk-REPLACE_ME
GEMINI_API_KEY=REPLACE_ME
# Monthly per-org AI spend cap in USD (NFR-COST)
AI_ORG_MONTHLY_BUDGET_USD=50

# --- Vector DB (RAG) -----------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Cloudinary (image uploads — e.g. user avatars) -----------------------
CLOUDINARY_CLOUD_NAME=REPLACE_ME
CLOUDINARY_API_KEY=REPLACE_ME
CLOUDINARY_API_SECRET=REPLACE_ME

# --- Object storage (S3-compatible: GCS / MinIO) -------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=engineeringos
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME

# --- Email (transactional) -----------------------------------------------
SMTP_URL=smtp://user:pass@localhost:1025
EMAIL_FROM=no-reply@engineeringos.local

# --- Observability -------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=debug

# --- Encryption (field-level for P3/P4 data — see docs/06) ----------------
# Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
